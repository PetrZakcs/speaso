{
  "expo": {
    "name": "Speasy",
    "slug": "speasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020810",
    "splash": {
      "backgroundColor": "#020810"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.speasy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020810",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.speasy.app"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "speasy",
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Sora-Regular.ttf",
            "./assets/fonts/Sora-SemiBold.ttf",
            "./assets/fonts/Sora-Bold.ttf",
            "./assets/fonts/Sora-ExtraBold.ttf",
            "./assets/fonts/DMSans-Regular.ttf",
            "./assets/fonts/DMSans-Medium.ttf",
            "./assets/fonts/DMSans-SemiBold.ttf",
            "./assets/fonts/DMSans-Bold.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-splash-screen"
    ]
  }
}

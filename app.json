{
  "expo": {
    "name": "Speaso",
    "slug": "speaso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F3EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.speaso.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "Povolte Face ID pro zabezpečení vašich dechových nahrávek a deníku řeči.",
        "NSCameraUsageDescription": "Speaso využívá přední kameru pro zrcadlový nácvik uvolnění čelisti a ramen. Záznam zůstává pouze v telefonu.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "panic",
            "UIApplicationShortcutItemTitle": "Panic záchrana dechu",
            "UIApplicationShortcutItemSubtitle": "Klidný dech pro uvolnění krku",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypePlay"
          },
          {
            "UIApplicationShortcutItemType": "checkin",
            "UIApplicationShortcutItemTitle": "Dnešní check-in",
            "UIApplicationShortcutItemSubtitle": "Zápis mluvení, vody a spánku",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCompose"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3F7F6C",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.speaso.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "speaso",
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Fraunces-SemiBold.ttf",
            "./assets/fonts/Fraunces-Bold.ttf",
            "./assets/fonts/Fraunces-Italic.ttf",
            "./assets/fonts/Fraunces-SemiBoldItalic.ttf",
            "./assets/fonts/DMSans-Regular.ttf",
            "./assets/fonts/DMSans-Medium.ttf",
            "./assets/fonts/DMSans-SemiBold.ttf",
            "./assets/fonts/DMSans-Bold.ttf"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3F7F6C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Speaso uses the microphone so you can record your practice and listen back. Recordings stay on your phone.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Povolte Face ID pro zabezpečení vašich dechových nahrávek a deníku řeči."
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Speaso využívá přední kameru pro zrcadlový nácvik uvolnění čelisti a ramen. Záznam zůstává pouze v telefonu.",
          "microphonePermission": "Speaso využívá mikrofon pro nácvik klidné mluvy.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "locales": {
      "cs": "./locales/cs.json",
      "en": "./locales/en.json"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "397f79c3-29fc-47e6-bb9b-70a832a62111"
      }
    },
    "owner": "petrprog",
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "url": "https://u.expo.dev/397f79c3-29fc-47e6-bb9b-70a832a62111"
    }
  }
}
